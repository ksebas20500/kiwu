<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de respaldo y transferencia (API 31+). Va todo, menos la sesión de la cuenta:
     los tokens de Firebase no deben viajar a los respaldos en la nube ni a otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cuenta.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cuenta.xml" />
    </device-transfer>
</data-extraction-rules>
