<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventana de arranque: fondo lavanda (claro) o azul noche (oscuro), a juego con el icono. -->
    <style name="Theme.Kiwu.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kiwu_splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Kiwu</item>
    </style>

    <style name="Theme.Kiwu" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kiwu_fondo</item>
    </style>

    <!-- Pantalla de «añadir tarea» del widget: transparente, para verla encima del escritorio. -->
    <style name="Theme.Kiwu.Flotante" parent="Theme.Kiwu">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
