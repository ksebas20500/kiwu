<?xml version="1.0" encoding="UTF-8"?>
<!-- Colores inspirados en Kiwu Light+ de VS Code. Licencia: MIT (parte de Kiwu). -->
<style-scheme id="kiwu-light" name="Kiwu Light+" version="1.0">
  <author>Kiwu</author>
  <description>Colores de código tipo Kiwu Light+</description>
  <style name="text" foreground="#1F1F1F" background="#F5F5F5"/>
  <style name="selection" background="#ADD6FF"/>
  <style name="cursor" foreground="#000000"/>
  <style name="current-line" background="#F5F5F5"/>
  <style name="line-numbers" foreground="#008000" background="#F5F5F5"/>
  <style name="def:comment" foreground="#008000" italic="true"/>
  <style name="def:shebang" foreground="#008000" italic="true"/>
  <style name="def:doc-comment-element" foreground="#008000" italic="true"/>
  <style name="def:string" foreground="#A31515"/>
  <style name="def:special-char" foreground="#EE0000"/>
  <style name="def:keyword" foreground="#0000FF"/>
  <style name="def:statement" foreground="#AF00DB"/>
  <style name="def:type" foreground="#267F99"/>
  <style name="def:function" foreground="#795E26"/>
  <style name="def:builtin" foreground="#795E26"/>
  <style name="def:constant" foreground="#0070C1"/>
  <style name="def:special-constant" foreground="#0000FF"/>
  <style name="def:boolean" foreground="#0000FF"/>
  <style name="def:decimal" foreground="#098658"/>
  <style name="def:base-n-integer" foreground="#098658"/>
  <style name="def:floating-point" foreground="#098658"/>
  <style name="def:complex" foreground="#098658"/>
  <style name="def:number" foreground="#098658"/>
  <style name="def:preprocessor" foreground="#AF00DB"/>
  <style name="def:identifier" foreground="#001080"/>
  <style name="def:variable" foreground="#001080"/>
  <style name="def:operator" foreground="#1F1F1F"/>
  <style name="def:note" foreground="#008000" bold="true"/>
  <style name="def:error" foreground="#f44747" underline="error"/>
  <style name="def:warning" underline="error"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:heading" foreground="#0000FF" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:link-text" foreground="#267F99" underline="single"/>
  <style name="def:link-destination" foreground="#A31515"/>
  <style name="def:inline-code" foreground="#A31515"/>
  <style name="xml:tag" foreground="#800000"/>
  <style name="xml:attribute-name" foreground="#E50000"/>
  <style name="xml:attribute-value" foreground="#A31515"/>
  <style name="html:tag" foreground="#800000"/>
  <style name="html:attrib-name" foreground="#E50000"/>
  <style name="css:at-rules" foreground="#AF00DB"/>
  <style name="css:keyword" foreground="#001080"/>
  <style name="json:keyword" foreground="#001080"/>
</style-scheme>
