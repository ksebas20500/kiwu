<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".KiwuApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kiwu">

        <!-- ID de aplicación de AdMob: de prueba en depuración y minificado; en release sale de admob.properties (ver build.gradle.kts). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kiwu.Arranque"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".notify.AlarmaReceiver" android:exported="false" />
        <receiver android:name=".notify.AccionReceiver" android:exported="false" />
        <receiver android:name=".notify.ClaseReceiver" android:exported="false" />
        <receiver android:name=".notify.RachaReceiver" android:exported="false" />
        <receiver android:name=".widgets.DeberesWidgetReceiver" android:exported="false" android:label="@string/widget_deberes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_deberes" />
        </receiver>
        <receiver android:name=".widgets.HorarioWidgetReceiver" android:exported="false" android:label="@string/widget_horario">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_horario" />
        </receiver>
        <receiver android:name=".widgets.NotasWidgetReceiver" android:exported="false" android:label="@string/widget_notas">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_notas" />
        </receiver>
        <receiver android:name=".widgets.WidgetAlarmaReceiver" android:exported="false" />
        <activity
            android:name=".widgets.ConfiguracionWidgetsActivity"
            android:exported="true"
            android:label="@string/widget_configuracion"
            android:theme="@style/Theme.Kiwu">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver android:name=".notify.ArranqueReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
